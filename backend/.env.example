# ====================================================================
# MULTI-AGENT DOCUMENT PROCESSING - ENVIRONMENT CONFIGURATION
# ====================================================================
# IMPORTANT:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env file to git (already in .gitignore)
# 4. Keep your API keys secure and rotate them regularly
# ====================================================================

# ====================================================================
# AI API KEYS (REQUIRED for full functionality)
# ====================================================================
# Get your Mistral API key from: https://console.mistral.ai/
# Used for: OCR Agent (Pixtral Vision Model)
MISTRAL_API_KEY=your_mistral_api_key_here

# Get your Gemini API key from: https://ai.google.dev/
# Used for: Extraction Agent & Summary Agent
GEMINI_API_KEY=your_gemini_api_key_here

# ====================================================================
# DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ====================================================================
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://myuser:mypassword@localhost:5432/multiagent_db
# SECURITY: Change default postgres password!
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/multiagent_db

# Enable/Disable pgvector extension (true/false)
# Requires pgvector extension installed in PostgreSQL
PGVECTOR_ENABLED=true

# ====================================================================
# SERVER CONFIGURATION
# ====================================================================
# Host to bind the server (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# Port number for the API server
PORT=8000

# Debug mode (true/false) - Set to false in production!
DEBUG=true

# ====================================================================
# FILE UPLOAD CONFIGURATION
# ====================================================================
# Directory to store uploaded files (relative or absolute path)
UPLOAD_FOLDER=./uploads

# Maximum file size for uploads (e.g., 50MB, 100MB, 1GB)
MAX_FILE_SIZE=50MB

# Allowed file extensions (comma-separated, no spaces)
# Supported: Documents (pdf, doc, docx, txt), Spreadsheets (csv, xls, xlsx), Images (jpg, jpeg, png, bmp, tiff)
ALLOWED_EXTENSIONS=pdf,csv,doc,docx,txt,xls,xlsx,jpg,jpeg,png,bmp,tiff

# ====================================================================
# AGENT CONFIGURATION
# ====================================================================

# OCR Agent Settings
# Maximum number of pages to process per PDF (1-1000)
OCR_MAX_PAGES=50

# Vector Agent Settings
# Dimension of vector embeddings (384, 512, 768, or 1024)
# 384 = faster, lower accuracy | 1024 = slower, higher accuracy
VECTOR_DIMENSION=384

# Embedding model from sentence-transformers
# Options:
#   - sentence-transformers/all-MiniLM-L6-v2 (default, fast, 384 dim)
#   - sentence-transformers/all-mpnet-base-v2 (better quality, 768 dim)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (multilingual)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Extraction Agent Settings
# Minimum confidence threshold for extracted fields (0.0 to 1.0)
# Lower = more permissive | Higher = more strict
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# Summary Agent Settings
# Maximum length of generated summaries (in characters)
SUMMARY_MAX_LENGTH=500

# ====================================================================
# ADDITIONAL SECURITY SETTINGS (Optional)
# ====================================================================
# Uncomment and set these for additional security in production

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# API rate limiting (requests per minute)
# RATE_LIMIT=100

# JWT secret key for authentication (if implementing auth)
# JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Session secret key
# SESSION_SECRET=your_session_secret_here

# ====================================================================
# LOGGING CONFIGURATION (Optional)
# ====================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Log file path
# LOG_FILE=./logs/app.log

# ====================================================================
# DEVELOPMENT VS PRODUCTION
# ====================================================================
# Development example:
#   DEBUG=true
#   HOST=127.0.0.1
#   DATABASE_URL=postgresql://postgres:dev123@localhost:5432/multiagent_dev
#
# Production example:
#   DEBUG=false
#   HOST=0.0.0.0
#   DATABASE_URL=postgresql://prod_user:strong_password@db.example.com:5432/multiagent_prod
#   CORS_ORIGINS=https://yourdomain.com
#   RATE_LIMIT=100
# ====================================================================
